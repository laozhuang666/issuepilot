# Optional, but recommended to avoid GitHub's low anonymous API rate limit.
GITHUB_TOKEN=

# Model provider: openai, deepseek, openrouter, or ollama.
# API keys are not required for a local Ollama server.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

ISSUEPILOT_MAX_REPOSITORY_FILES=500
ISSUEPILOT_MAX_CONTEXT_FILES=6
ISSUEPILOT_MAX_FILE_BYTES=120000
ISSUEPILOT_MAX_AGENT_ROUNDS=6
ISSUEPILOT_MAX_AGENT_CALLS_PER_ROUND=4
ISSUEPILOT_MAX_AGENT_SEARCH_FILES=20
ISSUEPILOT_MAX_TOOL_RESULT_CHARS=12000

